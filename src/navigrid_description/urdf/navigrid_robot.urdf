
<?xml version="1.0"?>
<robot name="navigrid_robot">

  <!-- ================= BASE ================= -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="1.0 0.7 0.3"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="1.0 0.7 0.3"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="10.0"/>
      <inertia
        ixx="0.8"
        ixy="0.0"
        ixz="0.0"
        iyy="1.2"
        iyz="0.0"
        izz="1.5"/>
    </inertial>
  </link>


  <!-- ================= LEFT WHEEL ================= -->

  <link name="left_wheel">

    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.08"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <inertia
        ixx="0.01"
        ixy="0"
        ixz="0"
        iyy="0.01"
        iyz="0"
        izz="0.01"/>
    </inertial>

  </link>

  <joint name="left_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel"/>

    <origin xyz="0 0.4 0.18"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ================= RIGHT WHEEL ================= -->

  <link name="right_wheel">

    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.08"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <inertia
        ixx="0.01"
        ixy="0"
        ixz="0"
        iyy="0.01"
        iyz="0"
        izz="0.01"/>
    </inertial>

  </link>

  <joint name="right_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel"/>

    <origin xyz="0 -0.4 0.18"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ================= CASTER ================= -->

  <link name="caster">

    <visual>
      <geometry>
        <sphere radius="0.12"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.12"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia
        ixx="0.005"
        ixy="0"
        ixz="0"
        iyy="0.005"
        iyz="0"
        izz="0.005"/>
    </inertial>

  </link>

  <joint name="caster_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="caster"/>

    <origin xyz="-0.38 0 0.12"/>

  </joint>


  <!-- ================= LIDAR ================= -->

  <link name="lidar_link">

    <visual>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
    </visual>

    <inertial>
      <mass value="0.2"/>
      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>
    </inertial>

  </link>

  <joint name="lidar_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="lidar_link"/>

    <origin xyz="0 0 0.38"/>

  </joint>


  <!-- ================= IMU ================= -->

  <link name="imu_link">

    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>
    </inertial>

  </link>

  <joint name="imu_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="imu_link"/>

    <origin xyz="0 0 0.25"/>

  </joint>


  <!-- ================= GAZEBO ================= -->

  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>


  <!-- ================= DIFF DRIVE ================= -->

  <gazebo>

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.8</wheel_separation>
      <wheel_radius>0.18</wheel_radius>

      <topic>/cmd_vel</topic>

      <odom_topic>/odom</odom_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

    </plugin>

  </gazebo>


  <!-- ================= LIDAR SENSOR ================= -->

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
<frame_id>lidar_link</frame_id>
      <topic>/scan</topic>
      <update_rate>10</update_rate>

      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.12</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ================= IMU SENSOR ================= -->

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <pose>0 0 0 0 0 0</pose>
      <topic>/imu</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>
</robot>
