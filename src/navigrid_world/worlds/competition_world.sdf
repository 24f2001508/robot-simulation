<?xml version="1.0" ?>
<sdf version="1.10">

  <world name="competition_world">

    <!-- Physics -->
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Light -->
    <light type="directional" name="sun">
      <pose>0 0 20 0 0 0</pose>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <!-- Ground -->
    <model name="ground">
      <static>true</static>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>30 30 0.1</size>
            </box>
          </geometry>
          <pose>0 0 -0.05 0 0 0</pose>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>30 30 0.1</size>
            </box>
          </geometry>
          <pose>0 0 -0.05 0 0 0</pose>
        </visual>

      </link>
    </model>

    <!-- North wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 15 0.75 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>30 0.2 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>30 0.2 1.5</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -15 0.75 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>30 0.2 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>30 0.2 1.5</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

    <!-- East wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>15 0 0.75 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 30 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 30 1.5</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

    <!-- West wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-15 0 0.75 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 30 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 30 1.5</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

    <!-- Rack 1 -->
    <model name="rack_1">
      <static>true</static>
      <pose>-5 5 1 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>6 1 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>6 1 2</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

    <!-- Rack 2 -->
    <model name="rack_2">
      <static>true</static>
      <pose>5 5 1 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>6 1 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>6 1 2</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

    <!-- Pillar 1 -->
    <model name="pillar_1">
      <static>true</static>
      <pose>-8 0 1 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.6</radius>
              <length>2</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.6</radius>
              <length>2</length>
            </cylinder>
          </geometry>
        </visual>

      </link>
    </model>

    <!-- Pillar 2 -->
    <model name="pillar_2">
      <static>true</static>
      <pose>8 0 1 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.6</radius>
              <length>2</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.6</radius>
              <length>2</length>
            </cylinder>
          </geometry>
        </visual>

      </link>
    </model>

    <!-- Zig-zag obstacle 1 -->
    <model name="zigzag_1">
      <static>true</static>
      <pose>-5 -5 0.75 0 0 0.35</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>6 0.8 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>6 0.8 1.5</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

    <!-- Zig-zag obstacle 2 -->
    <model name="zigzag_2">
      <static>true</static>
      <pose>3 -7 0.75 0 0 -0.35</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>6 0.8 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>6 0.8 1.5</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

    <!-- Elevated platform -->
    <model name="elevated_platform">
      <static>true</static>
      <pose>0 10 0.75 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>8 3 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>8 3 1.5</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

    <!-- Goal marker -->
    <model name="goal_marker">
      <static>true</static>
      <pose>12 12 0.02 0 0 0</pose>
      <link name="link">

        <visual name="visual">
          <geometry>
            <box>
              <size>2 2 0.04</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

  </world>
</sdf>
